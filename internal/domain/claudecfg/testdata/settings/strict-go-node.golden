{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook SessionStart",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook UserPromptSubmit",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook PreToolUse",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook PermissionRequest",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook Notification",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook PostToolUse",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook SubagentStart",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook SubagentStop",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook Stop",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/dev/My Tools/lyna-tmux' hook SessionEnd",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/go-build"
      ],
      "allowRead": [
        "~/.gitconfig",
        "~/.config/git"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "proxy.golang.org",
        "sum.golang.org",
        "mirror.example.org"
      ],
      "strictAllowlist": true
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.pypirc",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AZURE_CLIENT_SECRET",
          "mode": "deny"
        },
        {
          "name": "CARGO_REGISTRY_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLOUDFLARE_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "DIGITALOCEAN_ACCESS_TOKEN",
          "mode": "deny"
        },
        {
          "name": "DOCKER_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GOOGLE_API_KEY",
          "mode": "deny"
        },
        {
          "name": "HF_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NODE_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "PYPI_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SLACK_BOT_TOKEN",
          "mode": "deny"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "mode": "deny"
        },
        {
          "name": "TWINE_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "VAULT_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "'/Users/dev/My Tools/lyna-tmux' statusline"
  }
}
