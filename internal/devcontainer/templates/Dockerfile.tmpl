# Generated by lyna-tmux sandbox devcontainer init. Review changes before
# rebuilding: this image is the isolation boundary for Claude Code.
FROM debian:13-slim

ARG USERNAME={{.User}}
ARG USER_UID=1000
ARG USER_GID=1000
ARG TZ={{.Timezone}}
ARG CLAUDE_VERSION={{.ClaudeVersion}}

ENV TZ=${TZ} \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# iptables and ipset enforce the egress firewall; sudo runs only that script.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git iptables ipset less neovim procps sudo tmux tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" -m 0700 "/home/${USERNAME}/.claude" \
    && install -d -o "${USERNAME}" -g "${USERNAME}" -m 0755 {{.Workspace}}

# The marker lyna-tmux looks for before it treats a container as the isolation
# boundary. Container isolation is what allows bypassPermissions and lets the
# sandbox stop failing closed, so those relaxations must rest on this image
# and not on running in any container at all. Root owns it and it is read
# only: the container user cannot forge one at run time.
RUN install -d -m 0755 "$(dirname {{.Marker}})" \
    && printf 'user=%s\nworkspace=%s\n' "${USERNAME}" {{.Workspace}} > {{.Marker}} \
    && chown root:root {{.Marker}} \
    && chmod 0444 {{.Marker}}

# The firewall script and its allowlist are owned by root, so the container
# user cannot widen the allowlist. The sudoers rule allows exactly this
# command with no arguments ("" in sudoers).
COPY init-firewall.sh /usr/local/bin/init-firewall.sh
COPY allowed-domains /usr/local/etc/lyna-tmux/allowed-domains
RUN chown root:root /usr/local/bin/init-firewall.sh /usr/local/etc/lyna-tmux/allowed-domains \
    && chmod 0755 /usr/local/bin/init-firewall.sh \
    && chmod 0644 /usr/local/etc/lyna-tmux/allowed-domains \
    && printf '%s ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh ""\n' "${USERNAME}" > /etc/sudoers.d/lyna-tmux-firewall \
    && chmod 0440 /etc/sudoers.d/lyna-tmux-firewall \
    && visudo -cf /etc/sudoers.d/lyna-tmux-firewall

{{if .BinarySHA256 -}}
# lyna-tmux staged next to this Dockerfile by init: a build from the checkout
# on this machine, or the file given to --binary. The digest pins the file the
# Dockerfile was rendered for, so a swapped binary fails the build.
COPY lyna-tmux {{.BinaryPath}}
RUN printf '%s  %s\n' '{{.BinarySHA256}}' '{{.BinaryPath}}' | sha256sum --check --strict - \
    && chown root:root {{.BinaryPath}} \
    && chmod 0755 {{.BinaryPath}}
{{- else -}}
# lyna-tmux from its release, verified against the release checksums. The
# installer comes from the tag it installs.
RUN curl --proto '=https' --tlsv1.2 -fsSL "https://raw.githubusercontent.com/bayoudhdev/lyna-claude-tmux/{{.Version}}/scripts/install.sh" -o /tmp/install-lyna-tmux.sh \
    && sh /tmp/install-lyna-tmux.sh --prefix /usr/local/bin --version {{.Version}} \
    && rm /tmp/install-lyna-tmux.sh
{{- end}}

USER ${USERNAME}

# Claude Code native installer, installed for the container user.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://claude.ai/install.sh | bash -s "${CLAUDE_VERSION}"

ENV PATH=/home/${USERNAME}/.local/bin:${PATH} \
    CLAUDE_CONFIG_DIR=/home/${USERNAME}/.claude

WORKDIR /workspace
CMD ["sleep", "infinity"]
