# Starting an agent from the workspace: type, model, effort, worktree, prompt.
title s on the rail starts an agent
size 134 36
pre lmux kill --all
pre rm -rf .devcontainer
run lmux create . --layout duo --nested
wait 6
chapter Spawn
caption Alt+A then s | a form for the agent to start
keys M-A
wait 2.5
keys M-[
wait 1
frame 1.6
keys s
wait 2.5
frame 3
caption down, enter | its type, its model, its effort, its worktree
keys Down
wait 0.7
frame 1.6
keys Enter
wait 1.2
frame 2.4
keys Down
wait 0.7
frame 3
