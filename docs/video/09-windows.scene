# Windows of a workspace, and the tree over every workspace and window.
title Alt+n opens a window, Alt+1 switches, Alt+e is the tree
size 134 36
pre lmux kill --all
pre rm -rf .devcontainer
pre lmux create ../acme-web --layout duo --detach
pre lmux create . --layout duo --detach
run lmux create . --nested
wait 4
chapter Windows
caption Alt+n | a new window in the same workspace
frame 1.6
keys M-n
wait 2
frame 2
caption Alt+1 | back to the first one
keys M-1
wait 1.2
frame 2
caption Alt+e | every workspace and every window, in one tree
keys M-e
wait 2.5
frame 4
