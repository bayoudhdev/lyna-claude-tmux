# Splitting and zooming a pane, all without the prefix key.
title Alt+\ split right, Alt+- split down, Alt+z zoom
size 112 34
pre lmux kill --all
# The worktree branches another scene opened would fill the log line with
# decorations; the branch the pane is on is the one worth showing.
pre git config log.excludeDecoration refs/heads/worktree-*
pre rm -rf .devcontainer
pre lmux create . --layout solo --detach
run lmux create .
wait 4
frame 1.6
keys M-\
wait 1.8
type git log --oneline -5
enter
wait 1.2
frame 1.8
keys M--
wait 1.8
type go test ./internal/ratelimit/
enter
wait 3
frame 1.8
keys M-z
wait 1.5
frame 1.8
keys M-z
wait 1.5
frame 3
