# Moving the focus and resizing, with the pane borders naming each role.
title Alt+] and Alt+[ move, Alt+Shift+arrows resize, Alt+c returns to Claude
size 112 34
pre lyna-tmux kill --all
pre rm -rf .devcontainer
pre lyna-tmux create . --layout trio --detach
run lyna-tmux create .
wait 3
frame 1.4
keys M-]
wait 0.8
frame 1.2
keys M-]
wait 0.8
frame 1.2
keys M-S-Right
keys M-S-Right
keys M-S-Right
wait 0.8
frame 1.4
keys M-c
wait 0.8
frame 1.6
