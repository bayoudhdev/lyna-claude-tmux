# The built-in layouts, one after the other, driven from the shell of the
# workspace itself. The last frame is quad: one agent per worktree.
title lyna-tmux layout solo, duo, trio, quad
size 112 34
pre lyna-tmux kill --all
pre rm -rf .devcontainer
pre lyna-tmux create . --layout duo --detach
run lyna-tmux create .
wait 4
frame 1.6
keys M-]
wait 0.6
type lyna-tmux layout solo
enter
wait 3
frame 1.8
type lyna-tmux layout trio
enter
wait 3
frame 1.8
type lyna-tmux layout quad
enter
wait 8
frame 3
