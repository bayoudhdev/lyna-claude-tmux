# Windows: a new one, the number keys, and the tree of every workspace.
title Alt+n opens a window, Alt+1 and Alt+2 switch, Alt+e is the tree
size 112 34
pre lmux kill --all
pre rm -rf .devcontainer
pre lmux create ../acme-web --layout duo --detach
pre lmux create . --layout duo --detach
run lmux create . --nested
wait 4
frame 1.4
keys M-n
wait 2
frame 1.8
keys M-1
wait 1.2
frame 1.6
keys M-e
wait 2.5
frame 3.5
