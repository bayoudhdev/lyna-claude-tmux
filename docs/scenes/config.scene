# The configuration file: written documented, validated on demand.
title lyna-tmux config
size 104 30
run demo-shell
wait 1
type clear
enter
wait 0.5
type lyna-tmux config path
enter
wait 1.2
type lyna-tmux config validate
enter
wait 1.5
frame 2.6
type head -18 "$(lyna-tmux config path)"
enter
wait 1.5
frame 3.5
