# Listing and renaming workspaces.
title lmux ls and rename
size 104 30
pre lmux kill --all
pre rm -rf .devcontainer
pre lmux create ../acme-web --layout duo --detach
pre lmux create . --layout trio --detach
run demo-shell
wait 1
type clear
enter
wait 0.5
type lmux ls
enter
wait 2
frame 2.6
type lmux rename acme-api gateway
enter
wait 1.5
type lmux ls
enter
wait 1.5
frame 3.5
