# The dashboard: workspaces, agents and the actions that open them.
title lmux
env LYNA_TMUX_DEMO_AGENTS=1
size 104 30
pre lmux kill --all
pre rm -rf .devcontainer
pre lmux create ../acme-web --layout duo --detach
pre lmux create . --layout trio --detach
run lmux
wait 2.5
frame 2.4
keys Down
wait 0.7
frame 1.2
keys Down
wait 0.7
frame 1.2
keys Tab
wait 1
frame 2.4
